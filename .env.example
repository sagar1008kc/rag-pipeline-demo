# This tutorial uses xAI Grok. Get a key at https://console.x.ai
# Copy this file to .env. Do not commit .env.
XAI_API_KEY=xai-your-key-here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.6

# Any other OpenAI-compatible model: set these instead (they override XAI_*).
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
